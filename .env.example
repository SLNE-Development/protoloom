# Protoloom configuration. Copy to .env (git-ignored). See README.md "Configuration".

# --- Database / queue ---
DATABASE_URL=postgres://protoloom:protoloom@localhost:5432/protoloom
VALKEY_URL=redis://localhost:6379

# --- Storage: "local" or "s3" ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.data/storage
# Only for STORAGE_DRIVER=s3 (dev: the seaweedfs container from docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=protoloom
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth ---
# `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# Public https base URL, never derived from the request. Used for OAuth callbacks, cookies, absolute links.
BETTER_AUTH_URL=http://localhost:3000
# First admin: github:<login> or discord:<user id>
INITIAL_ADMIN=
# At least one provider (both id and secret) is required.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- docker-compose.prod.yml only ---
POSTGRES_PASSWORD=
# APP_PORT=3000

# --- docker-compose.coolify.yml only (otherwise generated by Coolify) ---
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY above override the bundled seaweedfs keys.

# --- Clients (CLI / Gradle plugin) ---
# PROTOLOOM_URL=https://protos.example.com
# PROTOLOOM_TOKEN=
