# Protoloom server configuration. Copy to `.env` in the repository root and fill in.
# Empty values count as unset.

# PostgreSQL connection string.
DATABASE_URL=
# Blob storage for archives: `local` or `s3`.
STORAGE_DRIVER=
# Directory for `STORAGE_DRIVER=local`.
STORAGE_LOCAL_PATH=
# S3 / MinIO settings for `STORAGE_DRIVER=s3` (endpoint optional for AWS).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Valkey (Redis-compatible) connection URL for the background worker queue, e.g. redis://localhost:6379.
VALKEY_URL=

# At least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public https base URL of this Protoloom. The only source for auth callbacks, secure cookies and
# invite links; never derived from incoming requests.
BETTER_AUTH_URL=

# First admin: `github:<login>` or `discord:<user id>`. Inert once an admin exists.
INITIAL_ADMIN=

# OAuth providers (login is OAuth only; configure at least one, each with both values).
# Callback URLs: ${BETTER_AUTH_URL}/api/auth/callback/github and .../callback/discord
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
