# Exact versions of the e2e stand-in images and clients; the only place they are pinned.
# Each is the newest release at least 14 days old when it was chosen (2026-10-22).
REGISTRY_IMAGE=registry:3.1.1
VERDACCIO_IMAGE=verdaccio/verdaccio:6.10.5
REPOSILITE_IMAGE=dzikoysk/reposilite:3.6.3
DIND_IMAGE=docker:29.8.2-dind
# Same tag as docker-compose.yml.
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48
YARN_CLASSIC=1.22.22
YARN_BERRY=4.18.1
BUN=1.4.2
# = the root package.json packageManager.
PNPM=11.13.0
# cosign for the signature flow of docker.sh (runs as a container).
COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v3.1.3
